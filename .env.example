# Copy to .env and adjust. Used by docker-compose and local dev.

# Postgres (match docker-compose service `db`)
POSTGRES_USER=ocean
POSTGRES_PASSWORD=ocean
POSTGRES_DB=ocean_read
# Local pytest / ``alembic`` on the host: point at published Postgres (Compose default **15432**).
# The **backend container** always uses ``db:5432`` from ``docker-compose.yml`` — it does not read this for DB host.
DATABASE_URL=postgresql+asyncpg://ocean:ocean@127.0.0.1:15432/ocean_read
# If you run the backend only inside Docker, you can omit DATABASE_URL or keep the line above for host tools only.

# API
API_HOST=0.0.0.0
API_PORT=8000

# Ollama on the host (schema agent, validation LLM fallback, open-ended, vision)
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gemma4:e4b
# Must match pgvector column width in migrations (legacy `chunks` table)
EMBEDDING_DIMENSION=768
# Set true to enable text LLM gap-fill after regex/layout
# VALIDATION_LLM_FALLBACK_ENABLED=true
# Recommended for invoices/forms: infer document structure then extract with layout-aware LLM (Ollama)
# VALIDATION_DOCUMENT_UNDERSTANDING_ENABLED=true
# Schema UI: POST /api/projects/.../validation-schemas/suggest-cross-field-rule (Ollama, temp 0)
# VALIDATION_SCHEMA_LLM_ASSIST_ENABLED=true
# DSL v3: open-ended fields in the schema always call Ollama at validation time.
# Set true to also allow open-ended on schemas without an open_ended block (legacy).
# VALIDATION_OPEN_ENDED_ENABLED=false
# Scanned/image PDFs: page images → Ollama vision (gemma4:e4b)
# VALIDATION_LLM_VISION_ENABLED=true
# VALIDATION_LLM_VISION_MAX_PAGES=4
SCHEMA_AGENT_URL=http://schema-agent:8081

# Storage (reserved for future on-disk artifacts; validation PDFs are not persisted)
UPLOAD_ROOT=/data/uploads

# Host port for pgAdmin (browser UI for Postgres). Login uses PGADMIN_DEFAULT_* below.
PGADMIN_PUBLISH=5050
PGADMIN_DEFAULT_EMAIL=admin@ocean-read.local
PGADMIN_DEFAULT_PASSWORD=ocean

# --- Edge (Traefik + optional forwardAuth) — see docs/DOCKER.md
GATEWAY_HTTP_PORT=8080
POSTGRES_PUBLISH=15432
COREDNS_UDP_PORT=55353
EDGE_AUTH_ENABLED=false
EDGE_API_TOKEN=

# Log viewer (/logs): Compose mounts Docker socket + LOG_VIEWER_ENABLED=true by default.
# Optional: LOG_VIEWER_TOKEN — rebuild frontend so VITE_LOG_VIEWER_TOKEN matches.

# --- Optional Airflow (`docker compose --profile airflow up`) — orchestration only; not used by validation core
# AIRFLOW_UI_PORT=8794

# start.sh: max time to wait for edge /api/health
# START_MAX_WAIT_SECONDS=240
# START_WAIT_INTERVAL_SECONDS=3
# start.sh: retry workspace seed (Default workspace + wine_quality @ 1.0)
# START_SEED_ATTEMPTS=5
# START_SEED_RETRY_SECONDS=5
# LLM extraction judge (non-regex winners) and schema judge (preview → authoring agent)
# VALIDATION_EXTRACTION_JUDGE_ENABLED=true
# VALIDATION_SCHEMA_JUDGE_ENABLED=true

# scripts/ensure_default_validation.py: wait for GET /api/projects before seeding
# SEED_MAX_WAIT_SECONDS=90
# SEED_WAIT_INTERVAL_SECONDS=3
